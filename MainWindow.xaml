                            <DataGrid x:Name="GamesGrid" Height="220"/>
                            <WrapPanel Margin="0,10,0,0"><Button x:Name="BtnAddGame" Content="Adicionar executável" Style="{StaticResource PrimaryButton}"/><Button x:Name="BtnDetectGames" Content="Detectar em pastas comuns"/><Button x:Name="BtnAddDetectedGame" Content="Adicionar detectado selecionado"/><Button x:Name="BtnRemoveGame" Content="Remover da lista"/><Button x:Name="BtnRunGameProfile" Content="Iniciar perfil selecionado" Style="{StaticResource PrimaryButton}"/><Button x:Name="BtnCreateGameShortcut" Content="Criar atalho otimizado"/><Button x:Name="BtnGameGpuPreference" Content="Preferência de GPU (manual)"/><Button x:Name="BtnGameFullscreenCompatibility" Content="Tela cheia (manual)"/></WrapPanel>
                            <TextBlock Text="Perfis apenas iniciam processos e aplicam preferências do Windows. Não há injeção, modificação de memória, cheats ou alteração de arquivos dos jogos." Style="{StaticResource MutedText}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel>
                            <TextBlock Text="Configuração do perfil selecionado" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Nome"/><TextBox x:Name="GameProfileNameTextBox" Width="220" automation:AutomationProperties.Name="Nome do perfil do jogo"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Argumentos opcionais"/><TextBox x:Name="GameProfileArgumentsTextBox" Width="260" automation:AutomationProperties.Name="Argumentos de linha de comando do jogo"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Prioridade"/><ComboBox x:Name="GameProfilePriorityCombo" Width="160"><ComboBoxItem Content="Normal"/><ComboBoxItem Content="AboveNormal" IsSelected="True"/><ComboBoxItem Content="High"/></ComboBox></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Plano durante o jogo"/><ComboBox x:Name="GameProfilePowerCombo" Width="190"><ComboBoxItem Content="None"/><ComboBoxItem Content="HighPerformance" IsSelected="True"/><ComboBoxItem Content="Ultimate"/><ComboBoxItem Content="Custom"/></ComboBox></StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="GameProfilePreventSleepCheck" Content="Impedir suspensão" IsChecked="True"/>
                                <CheckBox x:Name="GameProfileReduceVisualCheck" Content="Reduzir efeitos visuais temporariamente"/>
                                <CheckBox x:Name="GameProfileDoNotDisturbCheck" Content="Abrir Não Perturbe ao iniciar"/>
                                <CheckBox x:Name="GameProfileProcessListCheck" Content="Fechar a lista de processos configurada" IsChecked="True"/>
                                <CheckBox x:Name="GameProfileSelectedServicesCheck" Content="Usar serviços opcionais selecionados"/>
                            </WrapPanel>
                            <Button x:Name="BtnSaveGameProfile" Content="Salvar alterações do perfil" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                            <TextBlock Text="A preferência de GPU e a compatibilidade de tela cheia são abertas nas páginas oficiais, pois não há API pública estável por executável. Serviços vêm da seleção na página Processos e serviços." Style="{StaticResource MutedText}"/>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="#0D1626" BorderBrush="#26354B" BorderThickness="0,1,0,1" Padding="14,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="OperationStatusText" Text="Pronto." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" automation:AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar x:Name="OperationProgressBar" Grid.Column="1" Height="10" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Background="#172033" BorderThickness="0"/>
                    <Button x:Name="BtnCancelOperation" Grid.Column="2" Content="Cancelar" MinHeight="44" Padding="12,4" Margin="12,0,0,0" IsEnabled="False"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="#090F1B" Padding="14,8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Log da sessão" FontWeight="SemiBold"/>
                        <Button x:Name="BtnClearLogView" Grid.Column="1" Content="Limpar visualização" MinHeight="44" Padding="10,3" Margin="0"/>
                    </Grid>
                    <ListBox x:Name="LogListBox" Grid.Row="1" Margin="0,6,0,0" Background="#090F1B" Foreground="{StaticResource MutedTextBrush}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
