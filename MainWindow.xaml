<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Windows FPS Optimizer" Width="1100" Height="700"
        MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen" Language="pt-BR"
        Background="#0B1220" Foreground="#F8FAFC" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0E1728"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111A2A"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#172033"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1E40AF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B6C2D1"/>

        <Style x:Key="KeyboardFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#93C5FD" BorderThickness="2" CornerRadius="6" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#22304A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4A1820"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#17243A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#1D3355"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavBorder" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="#0D1626"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="White"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="#0D1626"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#BFDBFE"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#93C5FD"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0,2,12,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#27354A"/>
            <Setter Property="RowBackground" Value="#111A2A"/><Setter Property="AlternatingRowBackground" Value="#141F31"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#172033"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#334155"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#172033"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#26354B" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,12">
                    <TextBlock Text="Windows FPS" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Optimizer" FontSize="15" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Otimização local e reversível" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
                    <Border Background="#122136" CornerRadius="7" Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="AdminStatusText" Text="Permissões: verificando" FontSize="12"/>
                            <Button x:Name="BtnElevate" Content="Reiniciar como administrador" Margin="0,8,0,0" MinHeight="44"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationPanel">
                        <TextBlock Text="VISÃO GERAL" Foreground="#7F91AA" FontSize="10" FontWeight="Bold" Margin="18,8,0,4"/>
                        <Button x:Name="NavHome" Content="Início" Tag="&#xE80F;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavGaming" Content="Otimizações de jogos" Tag="&#xE7FC;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavPrograms" Content="Jogos e programas" Tag="&#xE71D;" Style="{StaticResource NavButton}"/>
                        <TextBlock Text="HARDWARE" Foreground="#7F91AA" FontSize="10" FontWeight="Bold" Margin="18,12,0,4"/>
                        <Button x:Name="NavPower" Content="CPU e energia" Tag="&#xE945;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavGraphics" Content="GPU e gráficos" Tag="&#xE7F4;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavMemory" Content="Memória RAM" Tag="&#xE950;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavStorage" Content="Armazenamento" Tag="&#xEDA2;" Style="{StaticResource NavButton}"/>
                        <TextBlock Text="SISTEMA" Foreground="#7F91AA" FontSize="10" FontWeight="Bold" Margin="18,12,0,4"/>
                        <Button x:Name="NavProcesses" Content="Processos e serviços" Tag="&#xE9D2;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavStartup" Content="Inicialização" Tag="&#xE768;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavVisual" Content="Interface e efeitos" Tag="&#xE790;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavApps" Content="Aplicativos do Windows" Tag="&#xE71D;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavPrivacy" Content="Privacidade e telemetria" Tag="&#xE72E;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavTasks" Content="Tarefas agendadas" Tag="&#xE823;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavSecurity" Content="Segurança e integridade" Tag="&#xE83D;" Style="{StaticResource NavButton}"/>
                        <Button x:Name="NavProfiles" Content="Perfis de otimização" Tag="&#xE8D7;" Style="{StaticResource NavButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0D1626" BorderBrush="#26354B" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="Início" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitleText" Text="Visão geral e ações recomendadas" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="SimulationCheckBox" Content="Simulação" IsChecked="True" ToolTip="Planeja e registra sem alterar o Windows."/>
                        <CheckBox x:Name="ReadOnlyCheckBox" Content="Somente leitura" ToolTip="Bloqueia todas as alterações e restaurações."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ContentHost" Grid.Row="1" Margin="20,16,8,8">
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Este computador" Style="{StaticResource SectionTitle}"/>
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Computador" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeComputerText" Text="—" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Windows" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeWindowsText" Text="—" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Processador" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeCpuText" Text="—" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Memória" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeRamText" Text="—"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Placa de vídeo" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeGpuText" Text="—" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Armazenamento" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeStorageText" Text="—"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Espaço livre" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeFreeSpaceText" Text="—"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Plano de energia" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomePowerText" Text="—" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Game Mode" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeGameModeText" Text="—"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="HAGS" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeHagsText" Text="—"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Processos" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeProcessText" Text="—"/></StackPanel>
                                        <StackPanel Margin="0,0,12,14"><TextBlock Text="Uso atual" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="HomeUsageText" Text="CPU — · RAM — · Disco —" TextWrapping="Wrap"/></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Prontidão do sistema" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ScoreText" Text="—" FontSize="54" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ScoreLabelText" Text="Clique em Analisar" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="Não é uma previsão de FPS." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Ações principais" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel>
                                    <Button x:Name="BtnAnalyze" Content="Analisar computador" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="BtnCreateBackup" Content="Criar backup"/>
                                    <Button x:Name="BtnQuickOptimize" Content="Otimização rápida"/>
                                    <Button x:Name="BtnRestoreLast" Content="Desfazer última otimização"/>
                                    <Button x:Name="BtnRestoreAll" Content="Restaurar tudo" Style="{StaticResource DangerButton}"/>
                                    <Button x:Name="BtnOpenBackup" Content="Abrir pasta de backup"/>
                                    <Button x:Name="BtnExportReport" Content="Exportar relatório"/>
                                    <Button x:Name="BtnImportBackup" Content="Importar backup"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Recomendações específicas" Style="{StaticResource SectionTitle}"/>
                                <DataGrid x:Name="RecommendationsGrid" Height="230" AutoGenerateColumns="True"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="BtnApplyRecommendation" Content="Aplicar selecionada" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="BtnUndoRecommendation" Content="Desfazer última aplicação"/>
                                    <Button x:Name="BtnRecommendationDetails" Content="Detalhes"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Backups persistentes" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Selecione uma transação. A restauração preserva alterações posteriores quando houver conflito." Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                                <DataGrid x:Name="BackupsGrid" Height="150" AutoGenerateColumns="True"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="BtnRefreshBackups" Content="Atualizar backups"/>
                                    <Button x:Name="BtnRefreshBackupEntries" Content="Carregar itens da transação"/>
                                    <Button x:Name="BtnRestoreSelectedBackup" Content="Restaurar transação inteira" Style="{StaticResource DangerButton}"/>
                                </WrapPanel>
                                <TextBlock Text="Itens da transação selecionada" Style="{StaticResource SectionTitle}" Margin="0,14,0,6"/>
                                <TextBlock Text="Valores originais e aplicados permanecem protegidos no manifesto; esta lista mostra apenas um resumo seguro." Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                                <DataGrid x:Name="BackupEntriesGrid" Height="190" AutoGenerateColumns="False" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="45"/>
                                        <DataGridTextColumn Header="Categoria" Binding="{Binding TypeLabel}" Width="150"/>
                                        <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="2*"/>
                                        <DataGridTextColumn Header="Recurso" Binding="{Binding Resource}" Width="2*"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="155"/>
                                        <DataGridTextColumn Header="Reversível" Binding="{Binding ReversibleText}" Width="85"/>
                                        <DataGridTextColumn Header="Reinício" Binding="{Binding RestartText}" Width="75"/>
                                        <DataGridTextColumn Header="Erro" Binding="{Binding Error}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="BtnRestoreSelectedEntry" Content="Restaurar somente o item selecionado" Style="{StaticResource DangerButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PageGaming" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Recursos do Windows para jogos" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Ações marcadas como manuais abrem a página oficial quando não existe API pública estável." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="BtnEnableGameMode" Content="Ativar Game Mode" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="BtnDisableCaptures" Content="Desativar capturas (quando suportado)"/>
                                    <Button x:Name="BtnOpenCaptures" Content="Abrir Capturas"/>
                                    <Button x:Name="BtnOpenGameBar" Content="Abrir Game Bar"/>
                                    <Button x:Name="BtnOpenHags" Content="Abrir HAGS"/>
                                    <Button x:Name="BtnOpenGraphicsSettings" Content="Preferência de GPU"/>
                                    <Button x:Name="BtnOpenFocus" Content="Não Perturbe / Foco"/>
                                    <Button x:Name="BtnOpenNotifications" Content="Notificações"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Executável e sessão de jogo" Style="{StaticResource SectionTitle}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="GameExecutableTextBox" automation:AutomationProperties.Name="Executável do jogo" IsReadOnly="True"/>
                                    <Button x:Name="BtnSelectGameExecutable" Grid.Column="1" Content="Selecionar .exe"/>
                                </Grid>
                                <WrapPanel>
                                    <CheckBox x:Name="GameSessionCloseProcessesCheck" Content="Fechar processos selecionados" IsChecked="True"/>
                                    <CheckBox x:Name="GameSessionServicesCheck" Content="Parar serviços opcionais selecionados"/>
                                    <CheckBox x:Name="GameSessionPowerCheck" Content="Usar plano de alto desempenho" IsChecked="True"/>
                                    <CheckBox x:Name="GameSessionPreventSleepCheck" Content="Impedir suspensão" IsChecked="True"/>
                                    <CheckBox x:Name="GameSessionVisualCheck" Content="Reduzir efeitos visuais" IsChecked="True"/>
                                    <CheckBox x:Name="GameSessionDoNotDisturbCheck" Content="Abrir Não Perturbe" IsChecked="True"/>
                                </WrapPanel>
                                <WrapPanel><TextBlock Text="Prioridade do jogo" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="GameSessionPriorityCombo" Width="160"><ComboBoxItem Content="Normal"/><ComboBoxItem Content="AboveNormal" IsSelected="True"/><ComboBoxItem Content="High"/></ComboBox></WrapPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnStartGameSession" Content="Iniciar sessão de jogo" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="BtnStopGameSession" Content="Encerrar e restaurar sessão" Style="{StaticResource DangerButton}"/>
                                </WrapPanel>
                                <TextBlock x:Name="GameSessionStatusText" Text="Nenhuma sessão ativa." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PagePower" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Energia e equipamento" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="PowerHardwareText" Text="Detectando desktop/notebook e processador..." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                <Border Background="#362713" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,12">
                                    <TextBlock Text="Aviso moderado: planos agressivos aumentam consumo, temperatura, ruído e podem reduzir a autonomia." TextWrapping="Wrap"/>
                                </Border>
                                <WrapPanel>
                                    <Button x:Name="BtnHighPerformance" Content="Ativar Alto Desempenho" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="BtnUltimatePerformance" Content="Ativar Desempenho Máximo" Style="{StaticResource DangerButton}"/>
                                    <Button x:Name="BtnCreateGamingPlan" Content="Criar plano para jogos"/>
                                    <Button x:Name="BtnRestorePowerPlan" Content="Restaurar plano anterior"/>
                                    <Button x:Name="BtnOpenPowerOptions" Content="Abrir Opções de Energia"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}"><StackPanel>
                                <TextBlock Text="Processador" Style="{StaticResource SectionTitle}"/>
